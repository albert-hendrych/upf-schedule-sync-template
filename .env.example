# UPF Matrícula / Secretaria Virtual Credentials
# Utilitza el teu DNI/identificador i la contrasenya del portal de matrícula
UNI_USERNAME=12345678A
UNI_PASSWORD=la_teva_contrasenya_de_matricula

# Portal URLs (Per defecte utilitza el portal de matrícula / horaris)
CAMPUS_LOGIN_URL=https://matricula.upf.edu/cosmos/Controlador/?apl=Uninavs&gu=a&idNav=inicio&NuevaSesionUsuario=true&NombreUsuarioAlumno=ALUMNO&responsive=S
SECRETARIA_AJAX_URL=https://secretariavirtual.upf.edu/pds/control/[Ajax]selecionarRangoHorarios?rnd=4236.0&start={start}&end={end}

# Google Calendar Integration
# Can be raw JSON string or Base64 encoded JSON of the Service Account key
GOOGLE_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# General Configuration
TIMEZONE=Europe/Madrid
HEADLESS_BROWSER=True
TRACE_DIR=artifacts/traces

# Optional: Filter specific seminar/practice groups when UPF shows all groups for a subject.
# Format: "CODE_OR_SUBJECT:GROUP1,GROUP2;OTHER_CODE:GROUP3" (or JSON dict)
# Example: SUBJECT_GROUP_FILTERS=23962:S201,P201
SUBJECT_GROUP_FILTERS=
